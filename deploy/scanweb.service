[Unit]
Description=ScanWeb - LAN scanner web UI
After=network.target

[Service]
Type=simple
User=scanops
Group=scanops
WorkingDirectory=/opt/scanweb
Environment=SCAN_ROOT=/opt/smb_share/scan
Environment=SCANWEB_PORT=9230
Environment=SCAN_DEVICE=hpljm1005:
# Environment=SCANWEB_TOKEN=在这里设置访问口令
# Environment=SCAN_SOURCE=ADF
# Environment=SCAN_MAX_TOTAL_BYTES=2147483648
# Environment=SCAN_MAX_AGE_DAYS=30
ExecStart=/opt/scanweb/.venv/bin/python /opt/scanweb/app.py
Restart=always
RestartSec=3
UMask=0002

[Install]
WantedBy=multi-user.target
