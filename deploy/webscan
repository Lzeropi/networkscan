#!/bin/bash
# webscan — ScanWeb 管理工具
# 安装位置：/usr/local/bin/webscan
# 用法：webscan <命令> [参数]
#
# 命令：
#   update [包路径]   一键更新（自动检测目录下的 scanweb-v*.tar.gz，或指定路径）
#   status            查看服务状态
#   restart           重启服务
#   stop              停止服务
#   start             启动服务
#   logs [行数]       查看最近日志（默认 50 行）
#   version           查看当前版本
#   uninstall         卸载（停止+禁用服务，保留数据和依赖）

set -Eeuo pipefail   # -E：errtrace，函数内命令失败也触发 ERR trap（v1.14.1 P0-1）

INSTALL_DIR="/opt/network_scan_service"
SERVICE_NAME="networkscan"
SERVICE_FILE="/etc/systemd/system/${SERVICE_NAME}.service"
BIN_PATH="/usr/local/bin/webscan"

# 颜色
red()    { printf "\033[31m%s\033[0m\n" "$*"; }
green()  { printf "\033[32m%s\033[0m\n" "$*"; }
yellow() { printf "\033[33m%s\033[0m\n" "$*"; }
bold()   { printf "\033[1m%s\033[0m\n" "$*"; }

# 更新时保留的文件/目录（不被覆盖）
PRESERVE=(".venv" "admin_config.json" "examples")

# ==================== 函数 ====================

cmd_update() {
    local pkg=""
    local tmp_dir=""
    local switched="no"   # v1.14.3（P2-7）：阶段标记——旧目录让位成功才置 yes，rollback 据此决定是否可删新目录

    # v1.14.2（#9）：更新全流程互斥——两次并发 update 会同时操作 .old/.preserve/service
    exec 9>/run/lock/scanweb-update.lock
    if ! flock -n 9; then
        echo "已有更新正在执行，请稍后再试"
        exit 1
    fi

    # 1. 确定更新包路径
    if [ $# -ge 1 ]; then
        pkg="$1"
    else
        # 自动检测目录下的 scanweb-v*.tar.gz
        pkg=$(ls -t "${INSTALL_DIR}"/scanweb-v*.tar.gz 2>/dev/null | head -1)
        if [ -z "$pkg" ]; then
            # 检测当前目录
            pkg=$(ls -t ./scanweb-v*.tar.gz 2>/dev/null | head -1)
        fi
    fi

    if [ -z "$pkg" ] || [ ! -f "$pkg" ]; then
        red "错误：找不到更新包"
        echo ""
        echo "用法："
        echo "  webscan update /path/to/scanweb-v1.13.tar.gz"
        echo "  或先将包放到 ${INSTALL_DIR}/ 再执行 webscan update"
        echo ""
        echo "从本机上传："
        echo "  scp scanweb-v*.tar.gz root@<盒子IP>:${INSTALL_DIR}/"
        return 1
    fi

    bold "ScanWeb 一键更新"
    echo "  更新包：$(basename "$pkg")"
    echo "  部署目录：${INSTALL_DIR}"
    echo ""

    # 2. 检查服务状态（v1.14.4：双状态——原 active/enabled 各自保持，
    # 原本 stopped 的更新后不得被误判失败回滚，也不得被擅自拉起）
    local was_running="no" was_enabled="no"
    if systemctl is-enabled --quiet "$SERVICE_NAME" 2>/dev/null; then
        was_enabled="yes"
    fi
    if systemctl is-active --quiet "$SERVICE_NAME" 2>/dev/null; then
        was_running="yes"
        yellow "停止服务..."
        systemctl stop "$SERVICE_NAME"
    fi

    # 3. 备份当前版本信息
    local old_ver="unknown"
    if [ -f "${INSTALL_DIR}/config.py" ]; then
        old_ver=$(grep -oP 'VERSION\s*=\s*"\K[^"]+' "${INSTALL_DIR}/config.py" 2>/dev/null || echo "unknown")
    fi

    # v1.14：先解压到临时目录并校验，再原子切换（#14，原「先删后解」存在断电残缺窗口）
    local tmp_extract=""
    tmp_extract=$(mktemp -d)
    if ! tar xzf "$pkg" -C "$tmp_extract" 2>/dev/null; then
        red "错误：更新包解压失败，已取消更新（服务未受影响）"
        rm -rf "$tmp_extract"
        return 1
    fi
    if [ ! -f "${tmp_extract}/scanweb/app.py" ]; then
        red "错误：更新包结构异常（缺少 scanweb/app.py），已取消更新（服务未受影响）"
        rm -rf "$tmp_extract"
        return 1
    fi
    local new_ver
    new_ver=$(grep -oP 'VERSION\s*=\s*"\K[^"]+' "${tmp_extract}/scanweb/config.py" 2>/dev/null || echo "unknown")

    echo "  旧版本：v${old_ver}"
    echo "  新版本：v${new_ver}"
    echo ""

    # 4. v1.14.1（P0-1）：三不变量重构——保留项移独立备份目录（不进新目录）、
    #    service 先备份、统一 rollback 函数 + ERR trap 全程兜底（中途任何失败也回滚）。
    local preserve_dir service_bak
    preserve_dir="${INSTALL_DIR}.preserve.$$"     # 与安装目录同分区，mv 秒级
    service_bak="/tmp/networkscan.service.bak.$$"
    rm -rf "$preserve_dir"
    mkdir -p "$preserve_dir"
    for item in "${PRESERVE[@]}"; do
        if [ -e "${INSTALL_DIR}/${item}" ]; then mv "${INSTALL_DIR}/${item}" "${preserve_dir}/"; fi
    done
    if [ -f "$SERVICE_FILE" ]; then
        cp "$SERVICE_FILE" "$service_bak"         # 旧 service 备份，回滚时恢复（防版本错配）
    fi

    # 统一回滚：切换前失败→原安装未动，不动目录只恢复 service；切换后失败→先从新目录
    # 逆移植保留项 → 清新目录 → 旧目录归位 → 保留项放回 → service 恢复 → 拉起旧版。
    # 任何路径下保留项必须完好（v1.14.1 P0-1）；switched 阶段守卫防「mv 失败却把
    # 唯一旧版删掉」（v1.14.3 P2-7：切换前 rm .old 成功但 mv 失败的极端场景）
    rollback() {
        # v1.14.5（C2）：各阶段显式 echo——保持「失败即停止」语义，但从静默变为可观察
        # （运维 journalctl 可见回滚走到哪步；不采用 set +e 半恢复，防更隐蔽的半恢复状态）
        yellow "回滚开始（switched=$switched）..."
        systemctl stop "$SERVICE_NAME" 2>/dev/null || true
        if [ "$switched" = "yes" ]; then
            yellow "回滚阶段1：暂存保留项 + 移除新版"
            for item in "${PRESERVE[@]}"; do
                if [ -e "${INSTALL_DIR}/${item}" ]; then mv "${INSTALL_DIR}/${item}" "${preserve_dir}/"; fi
            done
            rm -rf "${INSTALL_DIR}"
            yellow "回滚阶段2：恢复旧版 + 保留项归位"
            if [ -d "${INSTALL_DIR}.old" ]; then
                mv "${INSTALL_DIR}.old" "${INSTALL_DIR}"
            fi
            for item in "${PRESERVE[@]}"; do
                if [ -e "${preserve_dir}/${item}" ]; then mv "${preserve_dir}/${item}" "${INSTALL_DIR}/"; fi
            done
        else
            # v1.14.3（P2-7）：切换前失败——原安装未动，但保留项已提前搬入备份目录，
            # 必须先放回原目录再清备份（演练抓出：直接跳过会把 .venv/配置连带删掉）
            yellow "回滚：切换前失败——保留项放回原目录"
            for item in "${PRESERVE[@]}"; do
                if [ -e "${preserve_dir}/${item}" ] && [ ! -e "${INSTALL_DIR}/${item}" ]; then
                    mv "${preserve_dir}/${item}" "${INSTALL_DIR}/"
                fi
            done
        fi
        if [ -f "$service_bak" ]; then
            yellow "回滚阶段3：恢复 service 文件"
            cp "$service_bak" "$SERVICE_FILE"
            systemctl daemon-reload
        fi
        rm -rf "$preserve_dir" "$service_bak"
        if systemctl is-enabled --quiet "$SERVICE_NAME" 2>/dev/null; then
            yellow "回滚完成：重启旧服务"
            systemctl start "$SERVICE_NAME" 2>/dev/null || true
        else
            yellow "回滚完成：旧服务保持停止"
        fi
    }

    # 中途失败兜底：切换开始后任何命令失败（cp/chown/daemon-reload 等）都统一回滚后退出
    trap 'red "更新中途失败，自动回滚到 v${old_ver} ..."; rollback; exit 1' ERR

    # 5. 切换：旧目录让位 → 新代码落位 → 保留项归位
    yellow "切换版本（原子）..."
    rm -rf "${INSTALL_DIR}.old"
    mv "${INSTALL_DIR}" "${INSTALL_DIR}.old"
    switched="yes"   # v1.14.3（P2-7）：旧目录已让位——此后 rollback 才允许清理新目录/恢复旧版
    mkdir -p "${INSTALL_DIR}"
    cp -a "${tmp_extract}/scanweb/." "${INSTALL_DIR}/"
    rm -rf "$tmp_extract"
    rm -f "${INSTALL_DIR}/.python-version" 2>/dev/null || true
    for item in "${PRESERVE[@]}"; do
        if [ -e "${preserve_dir}/${item}" ]; then mv "${preserve_dir}/${item}" "${INSTALL_DIR}/"; fi
    done

    # 6. 清理更新包
    if [ -f "${INSTALL_DIR}/$(basename "$pkg")" ]; then
        rm -f "${INSTALL_DIR}/$(basename "$pkg")"
    fi

    # 7. 修复权限
    yellow "修复权限..."
    if id scanops &>/dev/null; then
        chown -R scanops:scanops "${INSTALL_DIR}"
    fi

    # 8. 更新 service 文件（如果包里有新的）
    if [ -f "${INSTALL_DIR}/deploy/networkscan.service" ]; then
        cp "${INSTALL_DIR}/deploy/networkscan.service" "$SERVICE_FILE"
        systemctl daemon-reload
    fi

    # 9. 更新 webscan 脚本自身
    if [ -f "${INSTALL_DIR}/deploy/webscan" ]; then
        cp "${INSTALL_DIR}/deploy/webscan" "$BIN_PATH"
        chmod +x "$BIN_PATH"
    fi

    # 10. 启动服务
    # v1.14.4（B4）：仅原运行中才拉起——「enabled 但手动停」保持停，「disabled」不拉起；
    # 验证也按原状态判断，stopped 状态的更新不得被误判失败而回滚
    if [ "$was_running" = "yes" ]; then
        yellow "启动服务..."
        systemctl start "$SERVICE_NAME"
        sleep 2
    fi
    trap - ERR    # 启动尝试完成，关闭中途兜底（下面的失败走显式回滚）

    # 11. 验证（v1.14.1：失败走统一 rollback——保留项/service 全量恢复）
    echo ""
    if [ "$was_running" = "yes" ]; then
        update_ok="no"
        systemctl is-active --quiet "$SERVICE_NAME" 2>/dev/null && update_ok="yes"
    else
        update_ok="yes"   # 原本 stopped：文件就绪即成功，不要求 active
    fi
    if [ "$update_ok" = "yes" ]; then
        rm -rf "${INSTALL_DIR}.old" "$preserve_dir" "$service_bak"   # 成功才清理旧版本与备份
        local port
        port=$(grep -oP 'SCANWEB_PORT=\K\d+' "$SERVICE_FILE" 2>/dev/null || echo "9203")
        green "更新成功！"
        echo "  版本：v${old_ver} → v${new_ver}"
        if [ "$was_running" = "yes" ]; then
            echo "  服务状态：active (running)"
        else
            echo "  服务状态：stopped（保持更新前状态）"
        fi
        echo "  访问地址：http://$(hostname -I 2>/dev/null | awk '{print $1}' || echo '<盒子IP>'):${port}"
        echo "  管理页：http://$(hostname -I 2>/dev/null | awk '{print $1}' || echo '<盒子IP>'):${port}/admin"
    else
        red "服务启动失败！自动回滚到 v${old_ver} ..."
        rollback
        sleep 2
        if systemctl is-active --quiet "$SERVICE_NAME" 2>/dev/null; then
            yellow "已回滚到旧版本 v${old_ver}（.venv/配置/service 全部保留），服务运行中。失败原因请检查："
        else
            red "回滚后服务仍未运行！请手动检查："
        fi
        echo "  systemctl status ${SERVICE_NAME} --no-pager"
        echo "  journalctl -u ${SERVICE_NAME} -n 20"
        return 1
    fi
}

cmd_status() {
    systemctl status "$SERVICE_NAME" --no-pager 2>/dev/null || red "服务未安装"
    echo ""
    local port
    port=$(grep -oP 'SCANWEB_PORT=\K\d+' "$SERVICE_FILE" 2>/dev/null || echo "9203")
    local ver
    ver=$(grep -oP 'VERSION\s*=\s*"\K[^"]+' "${INSTALL_DIR}/config.py" 2>/dev/null || echo "unknown")
    bold "ScanWeb 信息"
    echo "  版本：v${ver}"
    echo "  端口：${port}"
    echo "  目录：${INSTALL_DIR}"
    local resp
    resp=$(curl -s -o /dev/null -w "%{http_code}" "http://127.0.0.1:${port}/" 2>/dev/null || echo "000")
    if [ "$resp" = "200" ]; then
        green "  HTTP 响应：200 ✓"
    else
        red "  HTTP 响应：${resp} ✗"
    fi
}

cmd_restart() {
    systemctl restart "$SERVICE_NAME" 2>/dev/null
    sleep 2
    if systemctl is-active --quiet "$SERVICE_NAME" 2>/dev/null; then
        green "服务已重启"
    else
        red "重启失败"
    fi
}

cmd_stop() {
    systemctl stop "$SERVICE_NAME" 2>/dev/null
    green "服务已停止"
}

cmd_start() {
    systemctl start "$SERVICE_NAME" 2>/dev/null
    sleep 2
    if systemctl is-active --quiet "$SERVICE_NAME" 2>/dev/null; then
        green "服务已启动"
    else
        red "启动失败"
    fi
}

cmd_logs() {
    local lines="${1:-50}"
    journalctl -u "$SERVICE_NAME" -n "$lines" --no-pager 2>/dev/null
}

cmd_version() {
    local ver
    ver=$(grep -oP 'VERSION\s*=\s*"\K[^"]+' "${INSTALL_DIR}/config.py" 2>/dev/null || echo "unknown")
    echo "ScanWeb v${ver}"
    echo "部署目录：${INSTALL_DIR}"
}

cmd_uninstall() {
    red "警告：这将停止并移除 ScanWeb 服务（数据目录 /opt/smb_share/scans 保留）"
    read -p "确认卸载？输入 yes 继续：[N] " confirm
    if [ "$confirm" != "yes" ]; then
        echo "已取消"
        return
    fi
    systemctl stop "$SERVICE_NAME" 2>/dev/null || true
    systemctl disable "$SERVICE_NAME" 2>/dev/null || true
    rm -f "$SERVICE_FILE"
    rm -f "$BIN_PATH"
    systemctl daemon-reload
    rm -rf "$INSTALL_DIR"
    green "已卸载（扫描数据保留在 /opt/smb_share/scans）"
}

show_help() {
    bold "ScanWeb 管理工具"
    echo ""
    echo "用法：webscan <命令> [参数]"
    echo ""
    echo "命令："
    echo "  update [包路径]   一键更新（自动检测目录下的 scanweb-v*.tar.gz）"
    echo "  status             查看服务状态与版本信息"
    echo "  restart            重启服务"
    echo "  stop               停止服务"
    echo "  start              启动服务"
    echo "  logs [行数]        查看最近日志（默认 50 行）"
    echo "  version            查看当前版本"
    echo "  uninstall          卸载（保留扫描数据）"
    echo ""
    echo "更新示例："
    echo "  scp scanweb-v1.13.tar.gz root@<盒子IP>:/opt/network_scan_service/"
    echo "  ssh root@<盒子IP>"
    echo "  webscan update"
}

# ==================== 入口 ====================

CMD="${1:-help}"
shift 2>/dev/null || true

case "$CMD" in
    update)  cmd_update "$@" ;;
    status)  cmd_status ;;
    restart) cmd_restart ;;
    stop)    cmd_stop ;;
    start)   cmd_start ;;
    logs)    cmd_logs "$@" ;;
    version) cmd_version ;;
    uninstall) cmd_uninstall ;;
    help|-h|--help) show_help ;;
    *) red "未知命令：$CMD"; echo ""; show_help; exit 1 ;;
esac
